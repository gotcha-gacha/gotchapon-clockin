# Copy to .env.local (gitignored) for local development. Every name here is public by design:
# `EXPO_PUBLIC_*` is baked into the bundle at build time, so it is readable by anyone with the app.
# Secrets — the Privy app secret, a Google client secret, any private key — never go in either file.
#
# Two things about how these reach a build (CLAUDE.md, docs/WEB_BUILD_PLAN.md §4.5):
#   - `.env.local` leaks into an export. `pnpm export:web` runs with EXPO_NO_DOTENV=1 and passes what
#     it wants on the command line, so a deploy made that way cannot read this file — but a bare
#     `expo export` and `pnpm verify:web` DO read it (measured, docs/WEB_BUILD_PLAN.md §4.5). Keep
#     values here that would be safe to ship.
#   - EAS profiles set their own values in eas.json; a development build reads Metro's environment
#     instead, which is what this file is for.

# The API the app talks to. Set → the deployed Worker under server/. Unset → the in-app mock
# (development) or, in a release build, the connection-error card rather than fake stock.
EXPO_PUBLIC_API_URL=

# Development builds only. 1 → paid pulls skip the wallet transfer and let the local API exercise
# prepare/commit/reveal end to end. This is ignored in release builds and must never be enabled there.
EXPO_PUBLIC_DEV_PAYMENTS=

# Where a paid pull's USDC must go, pinned out of band (#186). The client decodes the server-built
# payment and refuses to sign unless it pays this token account in this mint. Public values, per
# environment, from server/wrangler.jsonc (TREASURY_USDC_TOKEN_ACCOUNT, USDC_MINT). Either unset →
# every paid pull against a real API is refused before anything is signed. Not read by the mock.
EXPO_PUBLIC_TREASURY_USDC_TOKEN_ACCOUNT=
EXPO_PUBLIC_USDC_MINT=

# 1 → the in-app mock, whatever EXPO_PUBLIC_API_URL says, with the demo pill in the header. A mock
# build is demo data end to end and its wallet is a fixture, so never hand one to anyone who might
# fund it (#185 takes the deposit surfaces off that screen). eas.json sets it 1 for development
# and development-device, 0 for preview, production, and testflight.
#
# Left empty on purpose: every development flow already picks the mock without it (src/api/index.ts:
# `usingMock = optIn || (__DEV__ && !baseUrl)`), and a value here would be baked into a bare
# `expo export` — see the note above. Set it to 1 only for a local Release proof build.
# Setting it to anything other than 1 does NOT turn the mock off: a development build with no
# EXPO_PUBLIC_API_URL still runs it. To reach a real server, set the URL.
EXPO_PUBLIC_USE_MOCK=

# Web only. 1 → the export may be indexed by search engines; anything else → every page ships
# `noindex` (src/app/+html.tsx). Production exports pass it on the command line; leave it unset here,
# so a demo or staging deploy can never be indexed by accident.
EXPO_PUBLIC_WEB_INDEXABLE=

# Feature-flag overrides for one build, as JSON (src/config/flags.ts). Unset is the v0 default:
# {"cardOnramp":"coming-soon","socialTicker":"launch","missingCard":true}. Unparseable JSON is ignored.
EXPO_PUBLIC_FLAGS=

# Privy's public ids, from dashboard.privy.io (App settings → Basics / Clients). The app id enables
# browser auth. A web app client is optional; set it only for client-specific restrictions or OAuth
# overrides, and never reuse the mobile client. Native still requires EXPO_PUBLIC_PRIVY_CLIENT_ID.
# The app secret is server-only and belongs in the Worker's secret store, never in an EXPO_PUBLIC var.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID_WEB=

# PostHog's project key, for analytics and error tracking (#143, Ben's pick 17 Sept; wired 21 Sept:
# src/analytics/posthog.ts on a phone, posthog.web.ts + its chunk in a browser). Unset → no SDK is
# constructed or fetched and events stay in a capped buffer; set → every event, the signed-in user's
# API id (never the wallet address) and caught errors go to that project. The key is public by design
# (it can only write events), but it still belongs in env rather than in app.json. For a web deploy it
# goes on the export's command line, like the mock flag (docs/WEB_BUILD_PLAN.md §4.5).
EXPO_PUBLIC_POSTHOG_KEY=
# The ingestion host, only if not PostHog's US cloud (https://us.i.posthog.com): the EU cloud
# (https://eu.i.posthog.com) or a reverse proxy.
EXPO_PUBLIC_POSTHOG_HOST=
